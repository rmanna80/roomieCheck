# Copy to .env (never commit .env). Expo inlines EXPO_PUBLIC_* values into the app bundle,
# so ONLY public values belong here.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable / anon key (safe in the app: RLS + RPC checks protect all data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# NEVER put the service-role key here. It lives only in Supabase Edge Function secrets.

# Optional: render the dev-only design preview in a non-dev build (demo data only)
# EXPO_PUBLIC_DESIGN_PREVIEW=1

# Database tests (npm run test:db): any PostgreSQL 15+ server you can create databases on
# TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
